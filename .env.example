# Agent Xi 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# LLM Provider 选择: "deepseek" | "claude" | "openai" | "ollama"
AGENT_XI_LLM_PROVIDER=deepseek

# DeepSeek API（默认 provider）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
AGENT_XI_LLM_MODEL=deepseek-chat
AGENT_XI_LLM_BASE_URL=https://api.deepseek.com

# Claude API
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# AGENT_XI_LLM_MODEL=claude-sonnet-4-20250514
# AGENT_XI_LLM_BASE_URL=https://api.anthropic.com

# OpenAI API
# OPENAI_API_KEY=your-openai-api-key-here
# AGENT_XI_LLM_MODEL=gpt-4o
# AGENT_XI_LLM_BASE_URL=https://api.openai.com

# Ollama 本地模型
# AGENT_XI_LLM_PROVIDER=ollama
# AGENT_XI_LLM_MODEL=qwen2.5:7b
# AGENT_XI_LLM_BASE_URL=http://localhost:11434

# 应用配置
# AGENT_XI_DEBUG=false
# AGENT_XI_MAX_HISTORY_TURNS=50

# Web 访问密码（设置后访问 UI 需先输密码，留空则不鉴权）
# XI_ACCESS_PASSWORD=your-password-here
